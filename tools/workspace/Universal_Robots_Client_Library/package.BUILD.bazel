# -*- mode: python -*-
# vi: set ft=python :

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "liburclient",
    srcs = glob([
        "src/**/*.cpp",
        "include/ur_client_library/**/*.h",
    ], allow_empty = True) + select({
        "@platforms//os:macos": ["3rdparty/endian/endian.h"],
        "//conditions:default": [],
    }),
    hdrs = glob(["include/ur_client_library/**/*.h"]),
    includes = ["include"] + select({
        "@platforms//os:macos": ["3rdparty/endian"],
        "//conditions:default": [],
    }),
    data = glob(["resources/**"]),
    linkopts = ["-lpthread"],
)
